<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FCPModUpdater.Gui.ViewModels"
             xmlns:views="using:FCPModUpdater.Gui.Views"
             x:Class="FCPModUpdater.Gui.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Styles/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="/Styles/Controls.axaml" />
  </Application.Styles>

  <Application.DataTemplates>
    <DataTemplate DataType="vm:InstalledModsViewModel"><views:InstalledModsView /></DataTemplate>
    <DataTemplate DataType="vm:InstallViewModel"><views:InstallView /></DataTemplate>
    <DataTemplate DataType="vm:VersionsViewModel"><views:VersionsView /></DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel"><views:SettingsView /></DataTemplate>
    <DataTemplate DataType="vm:OperationDialogViewModel"><views:OperationDialogView /></DataTemplate>
    <DataTemplate DataType="vm:UninstallDialogViewModel"><views:UninstallDialogView /></DataTemplate>
    <DataTemplate DataType="vm:GitMissingDialogViewModel"><views:GitMissingDialogView /></DataTemplate>
  </Application.DataTemplates>
</Application>
